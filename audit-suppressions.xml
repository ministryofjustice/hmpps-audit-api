<?xml version="1.0" encoding="UTF-8"?>

<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!-- Suppressing as we can't do anything about this, it's the latest version.
      Apache releases a new version every 2 months so Mohamad regularly checking and will update when a fix is out-->
    <suppress>
        <notes><![CDATA[
    file name: parquet-avro-1.17.1.jar
    ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.parquet/parquet-avro@.*$</packageUrl>
        <cve>CVE-2023-37475</cve>
    </suppress>
    <suppress>
        <notes><![CDATA[
   file name: netty-codec-smtp-4.1.127.Final.jar
   ]]></notes>
        <packageUrl regex="true">^pkg:maven/io\.netty/netty-codec-smtp@.*$</packageUrl>
        <vulnerabilityName>CVE-2025-59419</vulnerabilityName>
    </suppress>
<!-- aircompressor-2.0.2.jar is the latest version of aircompressor. parquet-java is in the process
     of being update to version 3.5 so we are suppressing this CVE until a fix is released. https://github.com/apache/parquet-java/issues/3387-->
    <suppress>
        <notes><![CDATA[
   file name: aircompressor-2.0.2.jar
   ]]></notes>
        <packageUrl regex="true">^pkg:maven/io\.airlift/aircompressor@.*$</packageUrl>
        <vulnerabilityName>CVE-2025-67721</vulnerabilityName>
    </suppress>
    <suppress>
        <notes><![CDATA[
   file name: httpcore-4.4.16.jar
   hadoop-client 3.5.0 transitively pulls HttpComponents Core 4.x.
   4.4.16 is the latest published 4.x release; CVE-2026-54399 affects Core 5.x parser logic.
   ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.httpcomponents/httpcore@4\.4\.16$</packageUrl>
        <cve>CVE-2026-54399</cve>
    </suppress>
</suppressions>